{
    "name": "andrewdyer/slim-api-template",
    "description": "A template for building modern backend REST APIs using the Slim Framework",
    "version": "0.0.0",
    "keywords": ["framework", "slim"],
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "andrewdyer/actions": "^1.3",
        "andrewdyer/cors-response-emitter": "^0.1.3",
        "andrewdyer/json-error-handler": "^0.3.1",
        "andrewdyer/settings": "^0.1.8",
        "andrewdyer/shutdown-handler": "^0.1.4",
        "illuminate/database": "^13.25",
        "monolog/monolog": "^3.10",
        "php-di/php-di": "^7.1.1",
        "robmorgan/phinx": "^0.16.12",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15.2",
        "vlucas/phpdotenv": "^5.6.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "friendsofphp/php-cs-fixer": "^3.95.18",
        "phpunit/phpunit": "^12.5.33",
        "zircote/swagger-php": "^6.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "workbench/*/"
        }
    ],
    "scripts": {
        "api-contract:generate": "openapi app --output resources/openapi.json",
        "cs": "php-cs-fixer fix",
        "db:migrate": "phinx migrate",
        "db:migrate:create": "phinx create",
        "db:rollback": "phinx rollback",
        "db:seed": "phinx seed:run",
        "db:seed:create": "phinx seed:create",
        "db:status": "phinx status",
        "post-install-cmd": "@api-contract:generate",
        "post-update-cmd": "@api-contract:generate",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
