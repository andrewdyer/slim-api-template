{
    "name": "andrewdyer/skeleton",
    "description": "A starter structure built with the Slim PHP framework",
    "keywords": ["framework", "slim"],
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "monolog/monolog": "^3.9",
        "php-di/php-di": "^7.1",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpunit/phpunit": "^9.5",
        "symfony/var-dumper": "^5.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "workbench/*/"
        }
    ],
    "scripts": {},
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
