{
    "name": "andrewdyer/slim-app-template",
    "description": "A template for building backend applications using the Slim PHP framework",
    "type": "project",
    "authors": [
        {
            "name": "andrewdyer",
            "email": "andrewdyer@outlook.com"
        }
    ],
    "scripts": {
        "test": "phpunit tests"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "monolog/monolog": "^3.8",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "workbench/*/"
        }
    ],
    "config": {
        "sort-packages": true
    }
}
