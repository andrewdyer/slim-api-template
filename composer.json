{
    "name": "andrewdyer/skeleton",
    "description": "A starter structure built with the Slim PHP framework",
    "type": "project",
    "authors": [
        {
            "name": "andrewdyer",
            "email": "andrewdyer@outlook.com"
        }
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Database\\Migrations\\": "database/migrations/"
        }
    },
    "require": {
        "illuminate/database": "^11.35",
        "php-di/php-di": "^7.0",
        "robmorgan/phinx": "^0.16.5",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65"
    }
}
