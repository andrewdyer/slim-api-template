# ============================================================================= #
# LOCAL ENVIRONMENT TEMPLATE                                                    #
#                                                                               #
# Copy this file to .env, replace placeholder values, and never commit .env.    #
# Production values are supplied by the deployment environment.                 #
# ============================================================================= #

# ============================================================================= #
# APPLICATION                                                                   #
#                                                                               #
# Controls the application name, runtime mode, encryption key, and local URL.   #
# Use a unique generated value for APP_KEY.                                     #
# ============================================================================= #
APP_NAME=Skeleton
APP_DEBUG=true
APP_ENV=dev
APP_KEY=replace-with-a-local-app-key
APP_URL=http://localhost:8888

# ============================================================================= #
# CORS                                                                          #
#                                                                               #
# Comma-separated browser origins allowed to call this API.                     #
# Use * only when credentials are not required.                                 #
# ============================================================================= #
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================= #
# DATABASE CONNECTION                                                           #
#                                                                               #
# Used by the application and Phinx to connect to the local MySQL container.    #
# DB_DATABASE, DB_USERNAME, and DB_PASSWORD also initialise the local app user. #
# ============================================================================= #
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=skeleton
DB_USERNAME=skeleton
DB_PASSWORD=replace-with-a-local-database-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ============================================================================= #
# LOCAL MYSQL CONTAINER                                                         #
#                                                                               #
# Used only by compose.yaml when MySQL first initialises its local data volume. #
# The application must use DB_USERNAME and DB_PASSWORD, not this account.       #
# ============================================================================= #
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# ============================================================================= #
# LOGGING                                                                       #
#                                                                               #
# Controls log naming, retention, formatting, and diagnostic detail.            #
# ============================================================================= #
LOGGER_NAME="logger"
LOGGER_HANDLER_LEVEL=DEBUG
LOGGER_HANDLER_MAX_FILES=30
LOGGER_FORMATTER_FORMAT="[%datetime%] %level_name%: %message% %context% %extra%\n"
LOGGER_FORMATTER_DATE_FORMAT="Y-m-d H:i:s"
LOGGER_FORMATTER_ALLOW_INLINE_LINE_BREAKS=true
LOGGER_FORMATTER_IGNORE_EMPTY_CONTEXT_AND_EXTRA=true
LOGGER_FORMATTER_INCLUDE_STACK_TRACES=false