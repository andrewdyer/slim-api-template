# This file is a "template" of which environment variable need to be defined for
# your application. Copy all of this file to an .env file for development and
# create environment variables when deploying to production.

# APP
# ==============================================================================
APP_DISPLAY_ERROR_DETAILS=true
APP_LOG_ERRORS=true
APP_LOG_ERROR_DETAILS=true

# DATABASE
# ==============================================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# LOGGER
# ==============================================================================
LOG_NAME=app
LOG_LEVEL=DEBUG
LOG_MAX_FILES=30
LOG_FORMAT="[%datetime%] %level_name%: %message% %context% %extra%\n"
LOG_DATE_FORMAT="Y-m-d H:i:s"
