# This file is a "template" of which environment variable need to be defined for
# your application. Copy all of this file to an .env file for development and
# create environment variables when deploying to production.

# APP
# ==============================================================================
APP_NAME=Skeleton
APP_DEBUG=true
APP_ENV=dev
APP_KEY=supersecretkeyyoushouldnotcommittogithub
APP_URL=http://localhost:8888

# CORS
# ==============================================================================
# Comma-separated list of allowed origins.
# Use * to allow any origin (credentials are disabled with wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# DATABASE
# ==============================================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# LOGGER
# ==============================================================================
LOGGER_NAME="logger"
LOGGER_HANDLER_LEVEL=DEBUG
LOGGER_HANDLER_MAX_FILES=30
LOGGER_FORMATTER_FORMAT="[%datetime%] %level_name%: %message% %context% %extra%\n"
LOGGER_FORMATTER_DATE_FORMAT="Y-m-d H:i:s"
LOGGER_FORMATTER_ALLOW_INLINE_LINE_BREAKS=true
LOGGER_FORMATTER_IGNORE_EMPTY_CONTEXT_AND_EXTRA=true
LOGGER_FORMATTER_INCLUDE_STACK_TRACES=false
