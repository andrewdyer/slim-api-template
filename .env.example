# This file is a "template" of which environment variable need to be defined for
# your application. Copy all of this file to an .env file for development and
# create environment variables when deploying to production.

# APP
# ==============================================================================
APP_ENV=dev
APP_DISPLAY_ERROR_DETAILS=true
APP_LOG_ERRORS=true
APP_LOG_ERROR_DETAILS=true

# DATABASE
# ==============================================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# LOGGER
# ==============================================================================
LOGGER_NAME="logger"
LOGGER_HANDLER_LEVEL=DEBUG
LOGGER_HANDLER_MAX_FILES=30
LOGGER_FORMATTER_FORMAT="[%datetime%] %level_name%: %message% %context% %extra%"
LOGGER_FORMATTER_DATE_FORMAT="Y n j, g:i a"
LOGGER_FORMATTER_ALLOW_INLINE_LINE_BREAKS=true
LOGGER_FORMATTER_IGNORE_EMPTY_CONTEXT_AND_EXTRA=true
LOGGER_FORMATTER_INCLUDE_STACK_TRACES=false

# VIEW
# ==============================================================================
VIEW_CACHE_DISABLED=true