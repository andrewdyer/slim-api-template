@baseUrl = http://localhost:8888
@userId = 1

### ==================================================
### USERS: LIST
### ==================================================
GET {{baseUrl}}/api/v1/users
Accept: application/json

###

### ==================================================
### USERS: LIST (PAGINATED - FIRST PAGE)
### ==================================================
GET {{baseUrl}}/api/v1/users?page=1&perPage=3
Accept: application/json

###

### ==================================================
### USERS: LIST (PAGINATED - SECOND PAGE)
### ==================================================
GET {{baseUrl}}/api/v1/users?page=2&perPage=3
Accept: application/json

###

### ==================================================
### USERS: CREATE
### ==================================================
POST {{baseUrl}}/api/v1/users
Content-Type: application/json
Accept: application/json

{
  "first_name": "Emily",
  "last_name": "Johnson",
  "email": "emily.johnson@example.com"
}

###

### ==================================================
### USERS: SHOW
### ==================================================
GET {{baseUrl}}/api/v1/users/{{userId}}
Accept: application/json

###

### ==================================================
### USERS: UPDATE
### ==================================================
PUT {{baseUrl}}/api/v1/users/{{userId}}
Content-Type: application/json
Accept: application/json

{
  "first_name": "Michael",
  "last_name": "Brown",
  "email": "michael.brown@example.com"
}

###

### ==================================================
### USERS: DELETE
### ==================================================
DELETE {{baseUrl}}/api/v1/users/{{userId}}
Accept: application/json